temprature=float(input("enter temprature:"))
if temprature>30:
    print("it's hot today")
elif tempreature>=15 and temprature<30:
    print("it's warm today")
else:
    print("it's cold today")


## odd and even



anual_salary=int(input("enter anual salary:"))
tax_amount=0
if anual_salary<=250000:
    tax_amount=0
elif anual_salary>250000 and anual_salary<=500000:
    tax_amount=(anual_salary*10)/100
elif anual_salary>500000 and anual_salary<=1000000:
    tax_amount=(anual_salary*15)/100
elif anual_salary>1000000:
     tax_amount=(anual_salary*30)/100
else:
    print("invalid amount")
print(f'your anual salary is = {anual_salary}')
print(f'taxable income = {tax_amount}')
print(f'remaining amount ={anual_salary-tax_amount}')
    





