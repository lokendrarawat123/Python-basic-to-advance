def userChoice(user_choice):
    if user_choice==1:
        name=input('Enter Your name: ')
        initial_balance=int(input('Enter your initial balance'))
        job_position=input('Enter your job position')
        b=Bank(name,initial_balance,job_position)
        print("Account Created succsessfully")
        b.userDetails()
    else:
        if user_choice==2:
            acc_number=input('Enter Your account number: ')
            status=findAccountbyAccountNumber(acc_number)
            if status:
                amount=int(input('Enter how many rupees want to deposite: '))
                b.depositeAmount(amount)
        elif user_choice==3:
            acc_number=input('Enter Your account number: ')
            status=findAccountbyAccountNumber(acc_number)
            if status:
                amount=int(input('Enter how many rupees want to withdraw: '))
                b.withdrwaAmount(amount)
        elif user_choice==4:
            acc_number=input('Enter Your account number: ')
            status=findAccountbyAccountNumber(acc_number)
            if status:
                b.findAccountbyAccountNumber(acc_number)
        elif user_choice==5:
            break()
        else:
            raise InvalidChoiceError('Account Number Error: Account not found with given account number does not found.')
        
        
        
    
        

