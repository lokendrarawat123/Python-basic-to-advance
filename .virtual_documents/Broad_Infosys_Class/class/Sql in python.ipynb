'''

Update table_name set column_name=value where pk=value;
==================
'''



# Staffs
sql='''
    update Staffs set staff_name='Kiran Khadka',staff_position='junior' where staff_id=3
    '''

try:
    conn.execute(sql)
    conn.commit()
    print('Update Succsessfulyy')
except sqlite3.OperationalError as e:
    print(f"Operational error: {e}")

    








sql='''

alter table Staffs
rename column staff_contact to staff_phone ;
'''
try:
    conn.execute(sql)
    conn.commit()
    print('Column Update Succsessfulyy')
except sqlite3.OperationalError as e:
    print(f"Operational error: {e}")





