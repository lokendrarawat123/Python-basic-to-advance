# dictionary Looping



'''
values()-->loops only values of dictionary
keys()-->loops only keys of dictionary 
items()-->loops both keys and values of dictionary

'''



for key in products.keys():
    print(key)


for val in products.values():
    print(val)


for key,value in products.items():
    print(f'{key}:{val'}


