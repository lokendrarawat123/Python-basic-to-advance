    logic.....
    print(...)
elif condition :
    logic.....
    print(...)
elif condition :
    logic.....
    print(...)
........
else:
logic.....
    print(...)
........  
    '''


temprature=float(input("enter temprature:"))
if temprature>30:
    print("it's hot today")
elif tempreature>=15 and temprature<30:
    print("it's warm today")
else:
    print("it's cold today")


