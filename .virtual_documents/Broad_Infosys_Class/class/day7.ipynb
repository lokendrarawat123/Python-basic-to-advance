# # Lab question 5: The 'Price is Right ' (Conditional Logic)  
# # you are given a list of product 
# prices:prices =[100,250,75,400,120,310]
# 1.Write a program that crates two new empty lists:cheap_items and expensive_items
# 2.loop through the prices list .if a price is greate than 200 ,
# append it to expesive_items .otherwise ,append it to cheap_items
# 3.print both lists and calculate the total count of items in each using the len()


prices =[100,250,75,400,120,310]
cheap_items=[]
expensive_items=[]
# for price in prices:
#     if price>200:
#         expensive_items.append(price)
#     else:
#         cheap_items.append(price)
for price in prices :
    expensive_items.append(price) if price>=200 else cheap_items.append(price)
print(cheap_items)
print(expensive_items)
print('total cheap items are =',len(cheap_items))
print('total expensive items are =',len(expensive_items))


