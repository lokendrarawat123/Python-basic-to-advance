amount = 12000 # Global variable (outside all functions)


def bank_system(amount):  # <-- PARAMETER (Enclosing Scope)
    def deposite():
        # Inner function scope (Local Scope)
        global amount
        amount += 100
        return amount
    print(deposite())
bank_system(amount)


