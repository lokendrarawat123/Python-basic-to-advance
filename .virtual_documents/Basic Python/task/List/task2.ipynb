n=int(input('Enter the number how many students wants to store : '))
for i in range(n):
    number=int(input(f'Enter {i+1}th number : '))
    set1.update({number})
    set1.add(number)
print(set1)
largest = float("-inf")
second_largest = float("-inf")

for num in set1:
    if num > largest:
        second_largest = largest  
        largest = num 
    elif num > second_largest and num != largest:
        second_largest = num
print(f'the second largest number is ={second_largest}')

    


