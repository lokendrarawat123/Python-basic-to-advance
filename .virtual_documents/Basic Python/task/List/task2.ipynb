# 2.WAP to separate positive, negative, and zero values from a tuple and store them in three different tuples.


tuple1=(-5,6,-8,5,0,4,6,3,0,-3,7,0,6,-8)
negative=[]
positive=[]
zero=[]
for i in tuple1:
    if i>0:
        positive.append(i)
    elif i==0:
        zero.append(i)
    else:
        negative.append(i)
positive_tuple=tuple(positive)
print(f'positive tuple= {positive_tuple}')
negative_tuple=tuple(negative)
print(f'negative tuple= {negative_tuple}')
zero_tuple=tuple(zero)
print(f'zero tuple = {zero_tuple}')

        
        


# 3.WAP to count the frequency of each element in a tuple and display the result as (element, frequency) pairs.



numbers = (1, 2, 3, 4, 2, 3, 1, 2, 5, 1)

checked = []  # गनिसकेका नम्बरहरू राख्न खाली लिस्ट

for i in numbers:
    # यदि यो नम्बर पहिले गनिएको छैन भने मात्र गन्ने
    if i not in checked:
        freq = numbers.count(i)  # नम्बर कति पटक आयो गन्ने
        print((i, freq))         # (element, frequency) प्रिन्ट गर्ने
        checked.append(i)        # गनिसकेपछि सम्झिनका लागि checked मा हाल्ने


# 4.WAP to find the second highest marks from a tuple of student records using a loop.


tuple1=(64, 3, 4, 5, 70, 7, 74, 43, 45, 47, 86, 56, 31)
largest=0
second_largest=0
for i in tuple1:
    if i>largest:
        second_largest=largest
        largest=i
    elif i>second_largest and i<=largest:
        second_largest=i
print(f'second largest number is = {second_largest}')
        



