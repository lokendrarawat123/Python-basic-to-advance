class Cal:
    def __init__(self,l,b,h):
        self.l=l
        self.b=b
        self.h=h
    def volume(self):
        print(self.l*self.b*self.h)
    def area(self):
        print(self.l*self.b)
obj=Cal(10,10,10)
obj.volume()
obj.area()





