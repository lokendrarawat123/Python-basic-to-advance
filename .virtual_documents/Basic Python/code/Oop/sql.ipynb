# insert data 
sql='''
insert into student(name,age,address)
values('Ram',20,'KTM')
'''
cursor.execute(sql)
conn.commit()
print("data saved succesfully")


## read data



sql='''
select * from student
'''

cursor.execute(sql)
data=cursor.fetchall()
for row in data:
    print(row)

print("data fetch succesfully")


# update data
sql='''
update student set name='sita',age=23 where id=2
'''

cursor.execute(sql)
