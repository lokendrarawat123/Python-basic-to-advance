from bs4 import BeautifulSoup,MarkupResemblesLocatorWarning
import requests
url="https://www.worldometers.info/world-population/nepal-population/"


response = requests.get(url)
response.encoding = 'utf-8'
soup = BeautifulSoup(response.text, "html.parser")
title = soup.title.string
table_code=soup.table


# table_code
tags=table_code.find_all('tr')
data_rows=[]



# for tag in tags:
#     data_rows.append(tag.text.strip())


# print(data_rows)


data_rows = []
for tag in tags:
    row = []
    cells = tag.find_all(['th', 'td'])
    
    # Cell haru ma loop chalaera text clean garne
    for cell in cells:
        clean_text = cell.text.strip()
        row.append(clean_text)
    if row:
        data_rows.append(row)




# # Result print garne
# for r in data_rows:
#     print(r)


import csv

filename = 'nepal_population.csv'
with open(filename, 'w', newline='', encoding='utf-8') as f:
    writer = csv.writer(f)
    writer.writerows(data_rows)

print(f'CSV saved: {filename}')


import pandas as pd
import matplotlib.pyplot as plt

df = pd.read_csv('nepal_population.csv', header=0)
df.columns = data_rows[0]
df = df[1:].reset_index(drop=True)

df['Year'] = df['Year'].astype(int)
df['Population'] = df['Population'].str.replace(',', '').astype(int)
df['Urban Population'] = df['Urban Population'].str.replace(',', '').astype(int)
df['Fertility Rate'] = df['Fertility Rate'].astype(float)
df = df.sort_values('Year').reset_index(drop=True)

fig, axes = plt.subplots(1, 3, figsize=(18, 5))

axes[0].plot(df['Year'], df['Population'], marker='o', color='blue')
axes[0].set_title('Nepal Total Population')
axes[0].set_xlabel('Year')
axes[0].set_ylabel('Population')
axes[0].tick_params(axis='x', rotation=45)

axes[1].bar(df['Year'], df['Urban Population'], color='orange')
axes[1].set_title('Nepal Urban Population')
axes[1].set_xlabel('Year')
axes[1].set_ylabel('Urban Population')
axes[1].tick_params(axis='x', rotation=45)

axes[2].plot(df['Year'], df['Fertility Rate'], marker='s', color='red')
axes[2].set_title('Nepal Fertility Rate')
axes[2].set_xlabel('Year')
axes[2].set_ylabel('Fertility Rate')
axes[2].tick_params(axis='x', rotation=45)

plt.tight_layout()
plt.show()






































