from bs4 import BeautifulSoup,MarkupResemblesLocatorWarning
import requests


url="https://www.worldometers.info/world-population/nepal-population/"


response = requests.get(url)
soup = BeautifulSoup(response.text, "html.parser")
title = soup.title.string
table_code=soup.table


# table_code
tags=table_code.find_all('tr')
data_rows=[]



# for tag in tags:
#     data_rows.append(tag.text.strip())


# print(data_rows)


data_rows = []

# Har row (tr) ma loop chalaune
for tag in tags:
    row = []
    
    # Row bhitra ko har column (th/td) fetch garne
    cells = tag.find_all(['th', 'td'])
    
    # Cell haru ma loop chalaera text clean garne
    for cell in cells:
        clean_text = cell.text.strip()
        row.append(clean_text)
    
    # Yadi row khali xaina bhane main data_rows ma thapne
    if row:
        data_rows.append(row)




