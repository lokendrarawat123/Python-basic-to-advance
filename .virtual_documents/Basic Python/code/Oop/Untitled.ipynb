# # class_obj syntax
# class <class_name>:
#     <method>


# obj=<class_name>()


class Car:
    data=True
    print(data)
# access attribute using class
print(Car.data)
# modify callss attr
Car.data=12
print(Car.data)
obj1=Car()
print(obj1.data)


class Hello:
    @staticmethod
    def hello():
        print('Hello')
    @staticmethod
    def hello1():
        print('HeLLo1')
obj=Hello()
obj.hello1()



