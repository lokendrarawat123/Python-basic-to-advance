


def cal(a,b):
    add=a+b
    multi=a*b
    sub=a-b
    div=a/b
    return add,multi,sub,div
a,b,c,d=cal(10,5)
print(a)
print(b)
print(c)
print(d)



# default arguments.
def sum(a,b=5):
    sum=a+b
    multi=a*b
    return sum,multi
summ=sum(5,19)
add,multi=summ
print(summ[0])
print(summ)
print(add)
print(multi)


